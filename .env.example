# ---- Storage (matches docker-compose.yml) ----
POSTGRES_DSN=postgresql://ragforge:ragforge@localhost:5433/ragforge
REDIS_URL=redis://localhost:6380/0

# ---- LLM backend: "ollama" (local, free) or "anthropic" (API, costs money) ----
LLM_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only needed when LLM_BACKEND=anthropic. Never commit the real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Models (downloaded from HuggingFace on first run, ~5 GB total) ----
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda

# ---- Retrieval knobs ----
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=5
RRF_K=60

# ---- Hallucination gate: min support score before we answer instead of refusing ----
GROUNDING_THRESHOLD=0.55
