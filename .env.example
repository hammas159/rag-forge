# ---- Storage (matches docker-compose.yml) ----
POSTGRES_DSN=postgresql://ragforge:ragforge@localhost:5433/ragforge
REDIS_URL=redis://localhost:6380/0

# ---- LLM backend: "ollama" (local, free) or "anthropic" (API, costs money) ----
LLM_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Only needed when LLM_BACKEND=anthropic. Never commit the real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Models ----
# Default profile is SMALL (~220 MB total) so the project runs on a modest
# connection and on CPU. The schema adapts to the embedding width automatically -
# re-run `make ingest` after changing EMBED_MODEL and the vector column is rebuilt.
#
#   profile  EMBED_MODEL                RERANK_MODEL                              size
#   small    BAAI/bge-small-en-v1.5     cross-encoder/ms-marco-MiniLM-L-6-v2      ~220 MB
#   large    BAAI/bge-m3                BAAI/bge-reranker-v2-m3                   ~4.5 GB
#
# The large profile is multilingual (it handles Urdu) and scores better; the
# comparison between the two is reported in RESULTS.md.
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBED_DIM=384
DEVICE=cuda

# ---- Retrieval knobs ----
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=5
RRF_K=60

# ---- Hallucination gate: min support score before we answer instead of refusing ----
GROUNDING_THRESHOLD=0.55
